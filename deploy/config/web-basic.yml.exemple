# exporter-toolkit web configuration: TLS with HTTP basic authentication.
# Install as /etc/exporter_proxy/web-basic.yml, owner root:exporter_proxy,
# mode 0640.
#
# Users are re-read on every request: changes apply without restart.
# Without tls_server_config, credentials would travel in clear text
# (exporter_proxy logs a warning at startup).
# Reference: https://github.com/prometheus/exporter-toolkit/blob/master/docs/web-configuration.md

tls_server_config:
  cert_file: /etc/exporter_proxy/tls/CHANGE_ME.crt
  key_file: /etc/exporter_proxy/tls/CHANGE_ME.key

basic_auth_users:
  # user: bcrypt hash of the password, generated with:
  #   htpasswd -nBC 12 "" | tr -d ':\n'
  prometheus: CHANGE_ME
